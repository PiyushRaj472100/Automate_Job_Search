# ==============================================================================
# Job Intelligence Platform - Environment Configuration
# ==============================================================================

# Core Application Settings
PROJECT_NAME="Personal Job Intelligence Platform"
ENVIRONMENT="development"  # development | staging | production
DEBUG=true
LOG_LEVEL="INFO"          # DEBUG | INFO | WARNING | ERROR | CRITICAL
API_V1_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000

# Security & CORS (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"

# ==============================================================================
# FUTURE PHASES CONFIGURATION (Planned for Subsequent Phases)
# ==============================================================================

# PostgreSQL (System of Record - Phase 1)
# POSTGRES_SERVER=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=job_intelligence
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
GEMINI_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
# DATABASE_URL=postgresql+asyncpg://postgres:postgres_secret@localhost:5432/job_intelligence

# Google Gemini API (Phase 3 - Resume/Job Matching)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-pro

# Google Sheets API (Operational Dashboard)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
# Or provide raw JSON:
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type": "service_account", ...}'
GOOGLE_SHEETS_SHARE_USER_EMAIL=your_email@gmail.com

