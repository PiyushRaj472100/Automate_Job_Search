PROJECT_NAME=Personal Job Intelligence Platform
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
# Required. No SQLite fallback.
DATABASE_URL=postgresql+asyncpg://pjip:pjip@localhost:5432/pjip
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Google Sheets Integration (specify either JSON or FILE)
# For Render: set GOOGLE_SERVICE_ACCOUNT_JSON to the raw service account JSON string
# or base64-encoded JSON string (base64 -w 0 service_account.json).
# Alternatively, upload a Render Secret File to /etc/secrets/service_account.json.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SHARE_USER_EMAIL=
REQUEST_TIMEOUT=20
RETRY_MAX_ATTEMPTS=3
MAX_UPLOAD_MB=10
